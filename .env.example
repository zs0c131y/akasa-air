# All optional. With nothing set the app runs on port 4000 with an embedded MongoDB.
PORT=4000
# Leave empty (or "embedded") to use the built-in MongoDB, persisted under ./data/mongo
MONGODB_URI=
# REQUIRED in production
JWT_SECRET=change-me
ACCESS_TTL=15m
REFRESH_DAYS=7
DATA_DIR=./data
SEED=true
# Behind a proxy (Railway, Heroku): 1. Cookies are Secure in production unless COOKIE_SECURE=false
TRUST_PROXY=0
COOKIE_SECURE=true
CORS_ORIGINS=
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15

# Email (Mailgun HTTP API) for sign-up confirmation and password reset. Leave empty to run without email:
# sign-up then works straight away, and links are printed in the server console instead of being sent.
APP_URL=http://localhost:4000
MAILGUN_API_KEY=
MAILGUN_BASE_URL=https://api.mailgun.net
FROM_EMAIL=
MAILGUN_SENDER_NAME=Layover
# Optional: only these email domains may sign up, comma separated (empty = anyone), e.g. example.com
ALLOWED_EMAIL_DOMAINS=

# Leave allowance per person per year, until the HOD changes it in the app (default 30)
LEAVE_ALLOWANCE_DAYS=30
# Extra email domains that must never be emailed (demo/test domains are always skipped)
NO_EMAIL_DOMAINS=

{
  "name": "leave-management",
  "version": "1.0.0",
  "private": true,
  "description": "Employee Leave Management System (MERN)",
  "workspaces": ["shared", "server", "client"],
  "scripts": {
    "setup": "npm install && npm run build",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "dev": "concurrently -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "seed": "npm run seed -w server",
    "test": "npm test -w shared -w server"
  },
  "devDependencies": { "concurrently": "^9.0.0" },
  "engines": { "node": ">=20.11" }
}
